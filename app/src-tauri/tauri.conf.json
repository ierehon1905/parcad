{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "parcad",
  "version": "0.0.1",
  "identifier": "dev.parcad.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "parcad",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
