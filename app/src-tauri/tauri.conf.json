{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParCAD",
  "mainBinaryName": "parcad-app",
  "version": "0.0.10",
  "identifier": "dev.parcad.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && cargo build --locked --release -p parcad-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ParCAD",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/parcad-occt-worker"
    ],
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../NOTICE.md": "licenses/NOTICE.md",
      "../../vendor/occt-sys/OCCT/LICENSE_LGPL_21.txt": "licenses/LICENSE_LGPL_21.txt",
      "../../vendor/occt-sys/OCCT/OCCT_LGPL_EXCEPTION.txt": "licenses/OCCT_LGPL_EXCEPTION.txt",
      "../../vendor/opencascade/LICENSE": "licenses/LICENSE_opencascade_LGPL_21.txt",
      "../../examples": "examples"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "MacOS/parcad": "../../target/release/parcad"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMjJFNzMwRDA4NUQ4RDYKUldUVzJJWFFNT2NpdnM2eFRVV01od3dPdkVsWUpVaUMvYWh4WWhtSnpnNlJ0MCtmeFY2b2QweEMK",
      "endpoints": [
        "https://github.com/ierehon1905/parcad/releases/latest/download/latest.json"
      ]
    }
  }
}
