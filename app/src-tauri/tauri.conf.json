{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParCAD",
  "mainBinaryName": "parcad-app",
  "version": "0.0.2",
  "identifier": "dev.parcad.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ParCAD",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/parcad-occt-worker"
    ],
    "resources": {
      "../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../LICENSE-APACHE": "licenses/LICENSE-APACHE",
      "../../NOTICE.md": "licenses/NOTICE.md",
      "../../vendor/occt-sys/OCCT/LICENSE_LGPL_21.txt": "licenses/LICENSE_LGPL_21.txt",
      "../../vendor/occt-sys/OCCT/OCCT_LGPL_EXCEPTION.txt": "licenses/OCCT_LGPL_EXCEPTION.txt",
      "../../vendor/opencascade/LICENSE": "licenses/LICENSE_opencascade_LGPL_21.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
