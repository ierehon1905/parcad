# Rust
/target/

# Node
node_modules/
app/dist/

# Tauri generated
app/src-tauri/gen/schemas/

# CLI and app output: renders, STL, STEP, reports. All reproducible.
/out/
app/src-tauri/*.stl
app/src-tauri/*.step

# Fusion exports used as ground truth while recreating a part. Not reproducible
# from this repo — but not ours to ship either, and 30 MB of it is mesh. The
# numbers that matter end up in eval/cases/ instead, which is the record that
# has to survive.
/reference/

# Source archives made for sharing
/parcad-*-source-*.zip

# Per-developer Claude Code settings: a Stop hook and dev-server configs, both
# local choices rather than project facts. CLAUDE.md is the tracked half.
.claude/

# macOS
.DS_Store

# The Tauri sidecar staging copy of the B-rep worker: 26 MB of OpenCASCADE,
# written by tools/build-worker.sh before every bundle.
app/src-tauri/binaries/
__pycache__/
