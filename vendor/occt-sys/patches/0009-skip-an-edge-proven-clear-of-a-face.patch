+static double MeasuredEdgeFace(const BOPDS_PDS&                     theDS,
+                               const occ::handle<IntTools_Context>& theContext,
+                               const double                         theFuzzyValue,
+                               const int                            theNE,
+                               const int                            theNF,
+                               const double                         theT1,
+                               const double                         theT2)
+{
+  TopoDS_Edge  aE    = TopoDS::Edge(theDS->Shape(theNE));
+  TopoDS_Face  aF    = TopoDS::Face(theDS->Shape(theNF));
+  const double aTolE = BRep_Tool::Tolerance(aE);
+  const double aTolF = BRep_Tool::Tolerance(aF);
+
