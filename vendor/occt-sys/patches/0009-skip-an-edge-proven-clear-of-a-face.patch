+                                   theDS->ShapeInfo(theNF).Box(),
+                                   aTrsf))
+    {
+      TopLoc_Location aLoc(aTrsf);
+      aE.Move(aLoc);
+      aF.Move(aLoc);
+    }
+    IntTools_EdgeFace anEdgeFace;
+    anEdgeFace.SetEdge(aE);
+    anEdgeFace.SetFace(aF);
+    anEdgeFace.SetFuzzyValue(theFuzzyValue);
+    anEdgeFace.SetContext(theContext);
+    anEdgeFace.SetRange(aRange);
+    anEdgeFace.Perform();
