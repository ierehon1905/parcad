+//! How a blend's cross-section is represented. The first three are circles
+//! in different parameterisations, Linear is a straight line (a chamfer),
+//! and CurvatureContinuous is a quintic between the rolling ball's contact
+//! points that matches each face's normal curvature, so the blend is G2 to
+//! its faces where a circle is only G1.
 enum BlendFunc_SectionShape
 {
   BlendFunc_Rational,
   BlendFunc_QuasiAngular,
   BlendFunc_Polynomial,
-  BlendFunc_Linear
+  BlendFunc_Linear,
+  BlendFunc_CurvatureContinuous
 };
 
 #endif // _BlendFunc_SectionShape_HeaderFile
