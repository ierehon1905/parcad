+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_FilletShape.hxx	2026-10-14 12:19:31
@@ -26,11 +26,19 @@
 //! -   ChFi3d_Polynomial, which corresponds to a
 //! polynomial approximation of circles. This type
 //! facilitates the implementation of the construction algorithm.
+//! -   ChFi3d_CurvatureContinuous, a blend that is G2 to the
+//! faces it joins: it runs between the same contact lines as the
+//! rolling ball of the given radius, but its section is a quintic
+//! whose curvature at each contact point equals the face's normal
+//! curvature there, zero on a plane. It is built only between two
+//! faces with a constant radius; a contour that needs anything else
+//! is reported with ChFiDS_SectionNotApplicable.
 enum ChFi3d_FilletShape
 {
   ChFi3d_Rational,
   ChFi3d_QuasiAngular,
-  ChFi3d_Polynomial
+  ChFi3d_Polynomial,
+  ChFi3d_CurvatureContinuous
 };
 
 #endif // _ChFi3d_FilletShape_HeaderFile
