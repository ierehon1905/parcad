 #define Eps 1.e-15
 
+//=======================================================================
+// function : SectionCurvature
+// purpose  : The curvature a planar section curve leaving S at (U, V)
+//           along the unit tangent T must have for the swept blend to be
+//           curvature continuous with S there, counted positive towards the
+//           unit in-plane normal M.
+//
+//           Two surfaces tangent along a common curve are G2 as soon as
+//           their normal curvatures agree in one direction transverse to it
+//           (Pegna & Wolter's linkage curve theorem), and the section's
+//           tangent is such a direction. The section is a normal section of
+//           the blend, so the blend's normal curvature along T is the
+//           section's curvature times M.N, where N is the common unit
+//           normal: hence the ratio.
+//=======================================================================
+static double SectionCurvature(const Adaptor3d_Surface& S,
+                               const double             U,
+                               const double             V,
+                               const gp_Vec&            T,
+                               const gp_Vec&            M)
+{
+  gp_Pnt P;
+  gp_Vec Du, Dv, Duu, Dvv, Duv;
+  S.D2(U, V, P, Du, Dv, Duu, Dvv, Duv);
+  gp_Vec N = Du.Crossed(Dv);
+  if (N.SquareMagnitude() < Eps)
+  {
+    // A singular point of the surface has no second fundamental form to read.
+    return 0.;
+  }
+  N.Normalize();
+  // T in the tangent basis (Du, Dv), through the first fundamental form.
+  const double E = Du.Dot(Du), F = Du.Dot(Dv), G = Dv.Dot(Dv);
+  const double a = T.Dot(Du), b = T.Dot(Dv);
+  const double det = E * G - F * F;
+  if (std::abs(det) < Eps)
+  {
+    return 0.;
+  }
+  const double alpha = (G * a - F * b) / det;
+  const double beta  = (E * b - F * a) / det;
+  gp_Vec       Dtt;
+  Dtt.SetLinearForm(alpha * alpha, Duu, 2. * alpha * beta, Duv, beta * beta, Dvv);
+  const double speed2 = alpha * alpha * E + 2. * alpha * beta * F + beta * beta * G;
+  if (speed2 < Eps)
+  {
+    return 0.;
+  }
+  return (Dtt.Dot(N) / speed2) / M.Dot(N);
+}
+
+//=======================================================================
+// function : CurvatureContinuousPoles
+// purpose  : The curvature-continuous section between the rolling ball's
+//           contact points: a quintic Bezier that leaves each point along
+//           the circle's own tangent, with the face's normal curvature in
+//           that direction (SectionCurvature), and passes through the
+//           circle's midpoint, so the blend removes or adds the depth the
+//           circular one would.
+//
+//           E1 and E2 point from the ball's centre to the contact points,
+//           NP is the section plane's normal, as GeomFill::GetCircle takes
+//           them; none need be unit, which is what lets Section
+//           differentiate this by perturbing its arguments.
+//
+//           With d the length of the tangent legs and phi the arc's angle,
+//           the midpoint condition gives d = (16/25) R tan(phi/4), and the
+//           end curvature of a quintic with collinear P0 P1 P2 offset by c
+//           normal to the leg is (4/5) c / d^2, hence c = (5/4) kappa d^2.
+//           P1, P2 then lie on the tangent line from P0 and 2d stays short
+//           of where the two tangent lines meet, R tan(phi/2), for every
+//           phi below pi, so the control polygon is convex and the section
+//           has no inflection.
+//=======================================================================
+static void CurvatureContinuousPoles(const Adaptor3d_Surface&    S1,
+                                     const double                U1,
+                                     const double                V1,
+                                     const Adaptor3d_Surface&    S2,
+                                     const double                U2,
+                                     const double                V2,
+                                     const gp_Pnt&               Pts1,
+                                     const gp_Pnt&               Pts2,
+                                     const gp_Vec&               E1,
+                                     const gp_Vec&               E2,
+                                     const gp_Vec&               NP,
+                                     const double                R,
+                                     NCollection_Array1<gp_Pnt>& Poles)
+{
+  const gp_Vec n1 = E1.Normalized(), n2 = E2.Normalized(), nz = NP.Normalized();
+  const double cosphi = std::max(-1., std::min(1., n1.Dot(n2)));
+  const double d      = (16. / 25.) * R * std::tan(std::acos(cosphi) / 4.);
+
+  // The tangents along the section, each pointing towards the other end.
+  const gp_Vec chord(Pts1, Pts2);
+  gp_Vec       t1 = nz.Crossed(n1);
+  if (t1.Dot(chord) < 0.)
+  {
+    t1.Reverse();
+  }
+  gp_Vec t2 = nz.Crossed(n2);
+  if (t2.Dot(chord) > 0.)
+  {
+    t2.Reverse();
+  }
+  // In-plane normals towards the centre, the side the section bends to.
+  const gp_Vec m1 = n1.Reversed(), m2 = n2.Reversed();
+  const double c1 = 1.25 * SectionCurvature(S1, U1, V1, t1, m1) * d * d;
+  const double c2 = 1.25 * SectionCurvature(S2, U2, V2, t2, m2) * d * d;
+
+  const int low = Poles.Lower();
+  Poles(low)     = Pts1;
+  Poles(low + 1) = Pts1.Translated(d * t1);
+  Poles(low + 2).SetXYZ(Pts1.XYZ() + 2. * d * t1.XYZ() + c1 * m1.XYZ());
+  Poles(low + 3).SetXYZ(Pts2.XYZ() + 2. * d * t2.XYZ() + c2 * m2.XYZ());
+  Poles(low + 4) = Pts2.Translated(d * t2);
+  Poles(low + 5) = Pts2;
+}
+
+//=======================================================================
+// function : DerivativeStep
+// purpose  : A parameter step along the spine that moves every argument of
+//           CurvatureContinuousPoles by about a thousandth of the radius:
+//           small enough for the O(h^2) truncation of a central difference,
+//           large enough to stay clear of round-off. Zero rates mean the
+//           section does not move and any step will do.
+//=======================================================================
+static double DerivativeStep(const double  R,
+                             const gp_Vec& Tg1,
+                             const gp_Vec& Tg2,
+                             const gp_Vec& DE1,
+                             const gp_Vec& DE2,
+                             const gp_Vec& DNP)
+{
+  double rate = std::max(Tg1.Magnitude(), Tg2.Magnitude());
+  rate        = std::max(rate, R * DE1.Magnitude());
+  rate        = std::max(rate, R * DE2.Magnitude());
+  rate        = std::max(rate, R * DNP.Magnitude());
+  return rate > Eps ? 1.e-3 * R / rate : 1.;
+}
