+  //! Moves thePnt2d to the foot of the perpendicular dropped from thePnt3d to
+  //! the surface, by Gauss-Newton iterations started at thePnt2d.
+  //! @return False, leaving thePnt2d as it was, if the foot is not found
+  //! inside theBox.
+  bool moveToFoot(const gp_XYZ& thePnt3d, const std::pair<gp_XY, gp_XY>& theBox, gp_XY& thePnt2d)
+  {
+    const Adaptor3d_Surface& aSurface = *this->getDFace()->GetSurface();
+    const gp_XY              aTol(this->getRangeSplitter().GetToleranceUV().first,
+                     this->getRangeSplitter().GetToleranceUV().second);
+    gp_XY                    aUV = thePnt2d;
+    for (int anIter = 0; anIter < 8; ++anIter)
+    {
+      gp_Pnt aPnt;
+      gp_Vec aDU, aDV;
+      aSurface.D1(aUV.X(), aUV.Y(), aPnt, aDU, aDV);
+      const double aUU  = aDU.SquareMagnitude();
+      const double aUV_ = aDU.Dot(aDV);
+      const double aVV  = aDV.SquareMagnitude();
+      const double aDet = aUU * aVV - aUV_ * aUV_;
+      if (!(aDet > 1.e-12 * aUU * aVV) || aUU < gp::Resolution() || aVV < gp::Resolution())
+      {
+        return false;
+      }
+      const gp_XYZ aResidual = thePnt3d - aPnt.XYZ();
+      const double aRU       = aResidual.Dot(aDU.XYZ());
+      const double aRV       = aResidual.Dot(aDV.XYZ());
+      const gp_XY  aStep((aVV * aRU - aUV_ * aRV) / aDet, (aUU * aRV - aUV_ * aRU) / aDet);
+      aUV += aStep;
+      if (aUV.X() < theBox.first.X() || aUV.Y() < theBox.first.Y() || aUV.X() > theBox.second.X()
+          || aUV.Y() > theBox.second.Y())
+      {
+        return false;
+      }
+      if (std::abs(aStep.X()) <= aTol.X() && std::abs(aStep.Y()) <= aTol.Y())
+      {
+        thePnt2d = aUV;
+        return true;
+      }
+    }
+    return false;
+  }
