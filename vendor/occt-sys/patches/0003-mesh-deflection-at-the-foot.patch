+      aMax.SetCoord(std::max(aMax.X(), aPnt.X()), std::max(aMax.Y(), aPnt.Y()));
+    }
+    const std::pair<double, double>& aTol = this->getRangeSplitter().GetToleranceUV();
+    const gp_XY                      aPad(aTol.first, aTol.second);
+    return {aMin - aPad, aMax + aPad};
