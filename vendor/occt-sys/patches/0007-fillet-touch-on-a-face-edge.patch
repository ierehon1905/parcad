+//=======================================================================
+// function : ChFi3d_SideOfPCurve
+// purpose  : which side of the pcurve <C> the point <q> lies on, as a sign;
+//           0 on the curve within confusion, or with no foot on it.
+//=======================================================================
+
+static int ChFi3d_SideOfPCurve(const occ::handle<Geom2d_Curve>& C,
+                               const double                     f,
+                               const double                     l,
+                               const gp_Pnt2d&                  q)
+{
+  Geom2dAPI_ProjectPointOnCurve foot(q, C, f, l);
+  if (foot.NbPoints() == 0)
+  {
+    return 0;
+  }
+  gp_Pnt2d p;
+  gp_Vec2d t;
+  C->D1(foot.LowerDistanceParameter(), p, t);
+  if (t.Magnitude() < gp::Resolution())
+  {
+    return 0;
+  }
+  const double side = t.Crossed(gp_Vec2d(p, q)) / t.Magnitude();
+  if (std::abs(side) <= Precision::PConfusion())
+  {
+    return 0;
+  }
+  return side > 0 ? 1 : -1;
+}
+
+//=======================================================================
+// function : ChFi3d_TouchesOnFace
+// purpose  : where the contact curve <IcFil> of a stripe, drawn on the face
+//           <Ishape>, touches an edge of that face inside both with no vertex
+//           to say so: a point on the curve and on the edge, with the edge
+//           leaving and entering it, so that the builder cuts both there and
+//           the face's wires meet at a vertex. Without it the trimmed face's
+//           outer wire touches its inner one at a point no vertex marks,
+//           which BRepCheck rejects. The edge's other faces are put in the
+//           data structure, which is what has them rebuilt with its pieces.
+//           A crossing of the edge is left alone, and so is a contact at a
+//           vertex.
+//=======================================================================
+
+static void ChFi3d_TouchesOnFace(TopOpeBRepDS_DataStructure&    DStr,
+                                 const int                      SolidIndex,
+                                 const int                      IcFil,
+                                 const int                      Ishape,
+                                 const ChFiDS_FaceInterference& Fi,
+                                 const double                   tol3d)
+{
+  if (Ishape <= 0 || IcFil == 0)
+  {
+    return;
+  }
+  const TopOpeBRepDS_Curve&        DSC = DStr.Curve(IcFil);
+  const occ::handle<Geom_Curve>&   C3d = DSC.Curve();
+  const occ::handle<Geom2d_Curve>& PC  = Fi.PCurveOnFace();
+  if (C3d.IsNull() || PC.IsNull())
+  {
+    return;
+  }
+  const TopoDS_Shape& FS = DStr.Shape(Ishape);
+  if (FS.ShapeType() != TopAbs_FACE)
+  {
+    return;
+  }
+  const TopoDS_Face& F  = TopoDS::Face(FS);
+  double             f1 = Fi.FirstParameter();
+  double             l1 = Fi.LastParameter();
+  if (f1 > l1)
+  {
+    std::swap(f1, l1);
+  }
+  const double        tol2d = 1.0e-10;
+  Geom2dAdaptor_Curve AC(PC, f1, l1);
+  IntRes2d_Domain     D1(PC->Value(f1), f1, tol2d, PC->Value(l1), l1, tol2d);
+  Bnd_Box2d           box1;
+  BndLib_Add2dCurve::Add(AC, 0.0, box1);
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E))
+    {
+      continue;
+    }
+    double                    f2;
+    double                    l2;
+    occ::handle<Geom2d_Curve> PE = BRep_Tool::CurveOnSurface(E, F, f2, l2);
+    if (PE.IsNull())
+    {
+      continue;
+    }
+    Geom2dAdaptor_Curve AE(PE, f2, l2);
+    Bnd_Box2d           box2;
+    BndLib_Add2dCurve::Add(AE, 0.0, box2);
+    if (box1.IsOut(box2))
+    {
+      continue;
+    }
+    gp_Pnt2d pf;
+    gp_Pnt2d pl;
+    BRep_Tool::UVPoints(E, F, pf, pl);
+    IntRes2d_Domain  D2(pf, f2, tol2d, pl, l2, tol2d);
+    Geom2dInt_GInter Inter;
+    Inter.Perform(AC, D1, AE, D2, tol2d, tol2d);
+    if (!Inter.IsDone() || Inter.NbSegments() > 0)
+    {
+      continue;
+    }
+    for (int k = 1; k <= Inter.NbPoints(); ++k)
+    {
+      const double u = Inter.Point(k).ParamOnFirst();
+      const double v = Inter.Point(k).ParamOnSecond();
+      if (u <= f1 + Precision::PConfusion() || u >= l1 - Precision::PConfusion()
+          || v <= f2 + Precision::PConfusion() || v >= l2 - Precision::PConfusion())
+      {
+        continue;
+      }
+      // A touch keeps the edge on one side of the curve through the point.
+      const double step =
+        std::min({(l2 - f2) * 1.0e-3, (v - f2) / 2.0, (l2 - v) / 2.0});
+      const int before = ChFi3d_SideOfPCurve(PC, f1, l1, PE->Value(v - step));
+      const int after  = ChFi3d_SideOfPCurve(PC, f1, l1, PE->Value(v + step));
+      if (before == 0 || before != after)
+      {
+        continue;
+      }
+      double                  fe;
+      double                  le;
+      occ::handle<Geom_Curve> CE = BRep_Tool::Curve(E, fe, le);
+      if (CE.IsNull())
+      {
+        continue;
+      }
+      const gp_Pnt P   = C3d->Value(u);
+      const gp_Pnt Q   = CE->Value(v);
+      const double tol = std::max({tol3d, P.Distance(Q), BRep_Tool::Tolerance(E), DSC.Tolerance()});
+      const int Ipt = DStr.AddPoint(TopOpeBRepDS_Point(gp_Pnt((P.XYZ() + Q.XYZ()) / 2.0), tol));
+      const int IE  = DStr.AddShape(E);
+      DStr.ChangeCurveInterferences(IcFil).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, IcFil, Ipt, u));
+      DStr.ChangeCurveInterferences(IcFil).Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, IcFil, Ipt, u));
+      DStr.ChangeShapeInterferences(IE).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, IE, Ipt, v));
+      DStr.ChangeShapeInterferences(IE).Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, IE, Ipt, v));
+      for (TopExp_Explorer fx(DStr.Shape(SolidIndex), TopAbs_FACE); fx.More(); fx.Next())
+      {
+        if (fx.Current().IsSame(F))
+        {
+          continue;
+        }
+        for (TopExp_Explorer ex2(fx.Current(), TopAbs_EDGE); ex2.More(); ex2.Next())
+        {
+          if (ex2.Current().IsSame(E))
+          {
+            DStr.AddShape(fx.Current());
+            break;
+          }
+        }
+      }
+    }
+  }
+}
