+//=======================================================================
+// function : ExtendedAlongTangents
+// purpose  : The curve with a straight piece of <theLength> continuing its
+//           end tangent at each end asked for, as one C1 B-spline.
+//=======================================================================
+static occ::handle<Geom2d_BoundedCurve> ExtendedAlongTangents(
+  const occ::handle<Geom2d_TrimmedCurve>& theCurve,
+  const double                            theLength,
+  const bool                              theAtStart,
+  const bool                              theAtEnd)
+{
+  occ::handle<Geom2d_BSplineCurve>      aSpline = Geom2dConvert::CurveToBSplineCurve(theCurve);
+  Geom2dConvert_CompCurveToBSplineCurve aJoined(aSpline);
+  constexpr double                      aTol = Precision::Confusion();
+  // A straight piece run at the curve's own end speed, so the join is C1 and
+  // the parallel of the whole is one continuous curve.
+  auto aPiece = [theLength](const gp_Pnt2d& theFrom, const gp_Vec2d& theAlong, const bool theForward) {
+    const gp_Dir2d               aDir(theAlong);
+    const gp_Pnt2d               aTo = theFrom.Translated((theForward ? theLength : -theLength) * gp_Vec2d(aDir));
+    NCollection_Array1<gp_Pnt2d> aPoles(1, 2);
+    aPoles(1) = theForward ? theFrom : aTo;
+    aPoles(2) = theForward ? aTo : theFrom;
+    NCollection_Array1<double>   aKnots(1, 2);
+    aKnots(1) = 0.;
+    aKnots(2) = theLength / theAlong.Magnitude();
+    NCollection_Array1<int>      aMults(1, 2);
+    aMults(1) = 2;
+    aMults(2) = 2;
+    return occ::handle<Geom2d_BoundedCurve>(new Geom2d_BSplineCurve(aPoles, aKnots, aMults, 1));
+  };
+  gp_Pnt2d aP;
+  gp_Vec2d aT;
+  if (theAtStart)
+  {
+    aSpline->D1(aSpline->FirstParameter(), aP, aT);
+    if (aT.Magnitude() > gp::Resolution())
+    {
+      aJoined.Add(aPiece(aP, aT, false), aTol, false);
+    }
+  }
+  if (theAtEnd)
+  {
+    aSpline->D1(aSpline->LastParameter(), aP, aT);
+    if (aT.Magnitude() > gp::Resolution())
+    {
+      aJoined.Add(aPiece(aP, aT, true), aTol, true);
+    }
+  }
+  return aJoined.BSplineCurve();
+}
+
+//=======================================================================
+// function : DivergingCorners
+// purpose  : Which ends of each spine edge meet the next edge at a corner
+//           their parallels at theOffset do not reach: a turn away from
+//           the offset side (re-entrant for an inward offset, salient for
+//           an outward one), or a cusp. Where two edges join tangent, or
+//           turn toward the offset side, the parallels cross on their own.
+//=======================================================================
+void DivergingCorners(
+  const TopoDS_Face&                                                                      theSpine,
+  const double                                                                            theOffset,
+  NCollection_DataMap<TopoDS_Shape, std::pair<bool, bool>, TopTools_ShapeMapHasher>& theCorners)
+{
+  constexpr double aTolAng = 1.e-7;
+  for (TopExp_Explorer aWires(theSpine, TopAbs_WIRE); aWires.More(); aWires.Next())
+  {
+    const TopoDS_Wire&                aWire = TopoDS::Wire(aWires.Current());
+    NCollection_Sequence<TopoDS_Edge> anEdges;
+    for (BRepTools_WireExplorer anExp(aWire, theSpine); anExp.More(); anExp.Next())
+    {
+      anEdges.Append(anExp.Current());
+      if (!theCorners.IsBound(anExp.Current()))
+      {
+        theCorners.Bind(anExp.Current(), std::make_pair(false, false));
+      }
+    }
+    const int aCount = anEdges.Length();
+    for (int i = 1; i <= aCount; ++i)
+    {
+      if (i == aCount && !aWire.Closed())
+      {
+        break;
+      }
+      const TopoDS_Edge& anE1 = anEdges(i);
+      const TopoDS_Edge& anE2 = anEdges(i % aCount + 1);
+      double             f1, l1, f2, l2;
+      occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(anE1, theSpine, f1, l1);
+      occ::handle<Geom2d_Curve> aC2 = BRep_Tool::CurveOnSurface(anE2, theSpine, f2, l2);
+      if (aC1.IsNull() || aC2.IsNull())
+      {
+        continue;
+      }
+      // The tangent along the wire: at the end of E1, at the start of E2.
+      const bool aRev1 = anE1.Orientation() == TopAbs_REVERSED;
+      const bool aRev2 = anE2.Orientation() == TopAbs_REVERSED;
+      gp_Pnt2d   aP;
+      gp_Vec2d   aT1, aT2;
+      aC1->D1(aRev1 ? f1 : l1, aP, aT1);
+      aC2->D1(aRev2 ? l2 : f2, aP, aT2);
+      if (aRev1)
+      {
+        aT1.Reverse();
+      }
+      if (aRev2)
+      {
+        aT2.Reverse();
+      }
+      const double aNorm   = aT1.Magnitude() * aT2.Magnitude();
+      const bool   aCorner = aNorm <= gp::Resolution() || aT1.Crossed(aT2) * theOffset < -aTolAng * aNorm * std::abs(theOffset)
+                             || aT1.Dot(aT2) < 0.;
+      // E1 ends, in its own parameter, at its last parameter when forward.
+      std::pair<bool, bool>& aFlags1 = theCorners.ChangeFind(anE1);
+      (aRev1 ? aFlags1.first : aFlags1.second) = aCorner;
+      std::pair<bool, bool>& aFlags2 = theCorners.ChangeFind(anE2);
+      (aRev2 ? aFlags2.second : aFlags2.first) = aCorner;
+    }
+  }
+}
