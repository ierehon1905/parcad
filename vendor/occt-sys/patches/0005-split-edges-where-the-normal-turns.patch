   if (P3dF.SquareDistance(P3dL) < mySquareMinSize)
   {
+    return;
+  }
+
+  // Held to AngleInterior like an interior link: a boundary link no interior
+  // link could be leaves every triangle on it standing on the whole link.
+  gp_Dir aNormF, aNormL;
+  if (GeomLib::NormEstim(theSurf, uvf, Precision::Confusion(), aNormF) == 0
+      && GeomLib::NormEstim(theSurf, uvl, Precision::Confusion(), aNormL) == 0
+      && aNormF.Angle(aNormL) > myParameters.AngleInterior)
+  {
+    midpar = (theFirst + theLast) * 0.5;
+    myCurve.D0(midpar, midP3d);
+    myDiscretTool.AddPoint(midP3d, midpar, false);
+
+    splitSegment(theSurf, theCurve2d, theFirst, midpar, theNbIter + 1);
+    splitSegment(theSurf, theCurve2d, midpar, theLast, theNbIter + 1);
     return;
   }
 
