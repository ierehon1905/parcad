+namespace
+{
+//! One face's adaptive integral about the point every face is integrated
+//! about, and the error it reached.
+template <class Inert>
+struct FaceIntegral
+{
+  TopoDS_Face Face;
+  Inert       G;
+  double      Error = 0.0;
+};
+
+//! Integrates each face with a face and a domain of its own: nothing is
+//! carried from one face's integral to the next.
+template <class Inert>
+struct FaceIntegrator
+{
+  std::vector<FaceIntegral<Inert>>* Faces;
+  double                            Eps;
+
+  void operator()(const int theIndex) const
+  {
+    FaceIntegral<Inert>& aFace = (*Faces)[theIndex];
+    BRepGProp_Face       BF;
+    BRepGProp_Domain     BD;
+    BF.Load(aFace.Face);
+    BD.Init(aFace.Face);
+    aFace.G.Perform(BF, BD, Eps);
+    aFace.Error = aFace.G.GetEpsilon();
+  }
+};
+
+//! The faces of S the adaptive loops below integrate exactly, in the order
+//! they add them, each to be integrated about thePnt; forVolume keeps the
+//! FORWARD and REVERSED ones alone, as the volume loop does. False when a
+//! face would be read from its triangulation or has no wire: those loops
+//! then run as they always have.
+template <class Inert>
+bool exactFaces(const TopoDS_Shape&               S,
+                const gp_Pnt&                     thePnt,
+                const bool                        SkipShared,
+                const bool                        forVolume,
+                std::vector<FaceIntegral<Inert>>& theFaces)
+{
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aFwdFMap;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aRvsFMap;
+  TopLoc_Location                                        aLocDummy;
+  for (TopExp_Explorer ex(S, TopAbs_FACE); ex.More(); ex.Next())
+  {
+    const TopoDS_Face& F     = TopoDS::Face(ex.Current());
+    const bool         isFwd = F.Orientation() == TopAbs_FORWARD;
+    const bool         isRvs = F.Orientation() == TopAbs_REVERSED;
+    if (SkipShared)
+    {
+      if (forVolume ? ((isFwd && !aFwdFMap.Add(F)) || (isRvs && !aRvsFMap.Add(F)))
+                    : !aFwdFMap.Add(F))
+      {
+        continue;
+      }
+    }
+    if (BRep_Tool::Surface(F, aLocDummy).IsNull() || F.NbChildren() == 0)
+    {
+      return false;
+    }
+    if (forVolume && !isFwd && !isRvs)
+    {
+      continue;
+    }
+    FaceIntegral<Inert> aFace;
+    aFace.Face = F;
+    aFace.G.SetLocation(thePnt);
+    theFaces.push_back(aFace);
+  }
+  return theFaces.size() > 1;
+}
+
+//! Every face's integral taken side by side and added in the faces' order,
+//! which is the sum one thread makes: the adaptive integrals are most of a
+//! measurement of a part in hundreds of B-spline faces.
+template <class Inert>
+double addInParallel(std::vector<FaceIntegral<Inert>>& theFaces,
+                     GProp_GProps&                     Props,
+                     const double                      Eps)
+{
+  FaceIntegrator<Inert> anIntegrator{&theFaces, Eps};
+  OSD_Parallel::For(0, static_cast<int>(theFaces.size()), anIntegrator);
+  double ErrorMax = 0.0;
+  for (const FaceIntegral<Inert>& aFace : theFaces)
+  {
+    if (ErrorMax < aFace.Error)
+    {
+      ErrorMax = aFace.Error;
+    }
+    Props.Add(aFace.G);
+  }
+  return ErrorMax;
+}
+} // namespace
